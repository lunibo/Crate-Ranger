{
  "name": "crate-ranger",
  "productName": "Crate Ranger",
  "version": "1.5.0",
  "description": "Crate Ranger – inoffizieller Desktop-Client für SoundScout mit Streaming, Download, Tagging und Bibliotheksverwaltung",
  "main": "./out/main/index.js",
  "author": "Crate Ranger",
  "license": "UNLICENSED",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist:win": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:dir": "electron-vite build && electron-builder --win --x64 --dir",
    "dist:win:installer": "electron-vite build && electron-builder --win nsis --x64 --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --x64 --publish never"
  },
  "dependencies": {
    "i18next": "27.2",
    "node-taglib-sharp": "^6.0.3"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.108.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.65.1",
    "rcedit": "^5.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-router-dom": "^7.18.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "zustand": "^5.1.0"
  }
}
